rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function authed() { return request.auth != null; }
    function isMember(roomId) {
      return authed() &&
        request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.members;
    }

    // User profiles: any signed-in user can look people up by email to start a chat;
    // only the owner can write their own profile (and FCM tokens).
    match /users/{uid} {
      allow read: if authed();
      allow create, update: if authed() && request.auth.uid == uid;
      allow delete: if false;
    }

    match /rooms/{roomId} {
      allow read: if authed() && request.auth.uid in resource.data.members;
      allow create: if authed() && request.auth.uid in request.resource.data.members;
      allow update: if authed() && request.auth.uid in resource.data.members;
      allow delete: if false;

      match /messages/{msgId} {
        allow read: if isMember(roomId);
        allow create: if isMember(roomId) && request.resource.data.senderId == request.auth.uid;
        // Messages are immutable, except members may add themselves to readBy.
        allow update: if isMember(roomId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']);
        allow delete: if false;
      }
    }
  }
}
